<!-- Adapted from MAA FightSettingsUserControl's ordered stage plan (AGPL-3.0). -->
<UserControl x:Class="Chao2Harvester.TaskOptionsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:dd="urn:gong-wpf-dragdrop"
 xmlns:hc="https://handyorg.github.io/handycontrol"
 xmlns:local="clr-namespace:Chao2Harvester">
 <UserControl.Resources>
  <DataTemplate x:Key="OptionTemplate">
     <StackPanel Margin="{Binding OptionMargin}" IsEnabled="{Binding IsAvailable}">
      <CheckBox IsChecked="{Binding Checked}" Visibility="{Binding BoolVisibility}" Margin="6,4" ToolTip="{Binding Description}">
       <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" />
      </CheckBox>
      <TextBlock Text="{Binding Notice}" Visibility="{Binding NoticeVisibility}" TextWrapping="Wrap"
       Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,2,6,4" />
      <Grid Visibility="{Binding NumberVisibility}" Margin="6,2" ToolTip="{Binding Description}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" VerticalAlignment="Center" />
       <hc:NumericUpDown Grid.Column="1" Value="{Binding Number}" Minimum="{Binding Min}" Maximum="{Binding Max}" Height="30"
        AutomationProperties.Name="{Binding Label}" />
      </Grid>
      <Grid Visibility="{Binding ChoiceVisibility}" Margin="6,2" ToolTip="{Binding Description}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" VerticalAlignment="Center" />
       <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Id"
        SelectedValue="{Binding ChoiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" AutomationProperties.Name="{Binding Label}" />
      </Grid>
      <StackPanel Visibility="{Binding TeamsVisibility}">
       <hc:Divider Content="{Binding Label}" HorizontalContentAlignment="Center" Margin="0,0,0,4" />
       <Grid Margin="6,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Content="添加队伍" Click="AddTeam" IsEnabled="{Binding CanAddTeam}" Height="30" Margin="0,2,6,0" VerticalAlignment="Top"
         hc:IconElement.Geometry="{StaticResource AddGeometry}" hc:IconElement.Width="12" hc:IconElement.Height="12" />
        <TextBlock Grid.Column="1" Text="沿用当前阵容" Visibility="{Binding EmptyTeamsVisibility}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,6" />
       <ListBox Grid.Column="1" ItemsSource="{Binding Teams}" Style="{StaticResource PlanList}"
        dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
        dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" PreviewMouseWheel="RouteScroll">
        <ListBox.ItemTemplate><DataTemplate>
         <Grid Margin="0,1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
          <Border Cursor="SizeAll" Background="Transparent" ToolTip="拖动调整顺序" Padding="3,8">
           <Path Data="{StaticResource AlignHStretchGeometry}" Fill="{DynamicResource SecondaryTextBrush}" Stretch="Uniform" />
          </Border>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Id"
           SelectedValue="{Binding TeamId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" AutomationProperties.Name="队伍序号" />
          <Button Grid.Column="2" Style="{StaticResource PlanIcon}" Click="RemoveTeam" ToolTip="删除队伍" AutomationProperties.Name="删除队伍"
           hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}" hc:IconElement.Width="12" hc:IconElement.Height="12" />
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       </Grid>
      </StackPanel>
      <StackPanel Visibility="{Binding StagesVisibility}">
       <hc:Divider Content="{Binding Label}" HorizontalContentAlignment="Center" Margin="0,0,0,7" />
       <TextBlock Text="尚未添加" Visibility="{Binding EmptyStagesVisibility}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,6" />
       <ListBox ItemsSource="{Binding Stages}" Style="{StaticResource PlanList}"
        dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
        dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" PreviewMouseWheel="RouteScroll">
        <ListBox.ItemTemplate><DataTemplate>
         <Grid Margin="0,2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
          <Border Cursor="SizeAll" Background="Transparent" ToolTip="拖动调整顺序" Padding="3,8">
           <Path Data="{StaticResource AlignHStretchGeometry}" Fill="{DynamicResource SecondaryTextBrush}" Stretch="Uniform" />
          </Border>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedValuePath="Id"
           SelectedValue="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" ToolTip="{Binding Label}" AutomationProperties.Name="挑战项目">
           <ComboBox.ItemTemplate><DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
             <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" VerticalAlignment="Center" />
             <Image Source="{Binding RewardIcon}" Width="20" Height="20" Margin="6,0,3,0" Stretch="Uniform" Visibility="{Binding IconVisibility}" />
             <TextBlock Text="{Binding Reward}" TextWrapping="NoWrap" Foreground="{DynamicResource SecondaryTextBrush}"
              Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
           </DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <hc:NumericUpDown Grid.Column="2" Visibility="{Binding CountVisibility}" Width="60" Margin="3,0,0,0"
           Value="{Binding Limit}" Minimum="0" Maximum="100" Height="30" ToolTip="挑战次数（0为不限）" AutomationProperties.Name="挑战次数" />
          <Button Grid.Column="3" Style="{StaticResource PlanIcon}" Width="24" Click="RemoveStage" ToolTip="删除项目" AutomationProperties.Name="删除项目"
           hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}" hc:IconElement.Width="12" hc:IconElement.Height="12" />
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <Button Content="{Binding AddLabel}" Click="AddStage" IsEnabled="{Binding CanAddStage}" Margin="6,6,6,0" Height="30"
        hc:IconElement.Geometry="{StaticResource AddGeometry}" hc:IconElement.Width="12" hc:IconElement.Height="12" />
      </StackPanel>
      <StackPanel Visibility="{Binding OrderVisibility}">
       <hc:Divider Content="{Binding Label}" HorizontalContentAlignment="Center" Margin="0,0,0,3" />
       <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource PlanList}" Margin="6,0"
        dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
        dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" PreviewMouseWheel="RouteScroll">
        <ListBox.ItemTemplate><DataTemplate>
          <Grid MinHeight="30" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <Border Cursor="SizeAll" Background="Transparent" ToolTip="拖动调整优先级" Padding="7,6">
            <Path Data="{StaticResource AlignHStretchGeometry}" Fill="{DynamicResource SecondaryTextBrush}" Stretch="Uniform" />
           </Border>
           <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}"><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" /></CheckBox>
           <hc:NumericUpDown Grid.Column="2" Visibility="{Binding CountVisibility}" Value="{Binding Limit}" Minimum="0" Maximum="100"
            Width="60" Height="30" ToolTip="次数（0为不限）" AutomationProperties.Name="次数" />
          </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </StackPanel>
  </DataTemplate>
 </UserControl.Resources>
 <hc:ScrollViewer x:Name="OptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
  IsInertiaEnabled="True" PanningMode="Both">
  <StackPanel Margin="0,0,12,10" HorizontalAlignment="Stretch">
   <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,10" Visibility="{Binding EmptyOptionsVisibility}" />
   <ItemsControl x:Name="RegularOptions" ItemTemplate="{StaticResource OptionTemplate}" ItemsSource="{Binding Options}" Visibility="{Binding RegularOptionsVisibility}">

   </ItemsControl>
   <StackPanel x:Name="OtherSettings" Visibility="{Binding OtherVisibility}" Margin="0,0,0,4">
    <ItemsControl x:Name="OtherSections" ItemsSource="{Binding OtherSections}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,0,0,2">
       <Expander Visibility="{Binding DetailsVisibility}" HorizontalContentAlignment="Stretch" Padding="0">
        <Expander.Header>
         <CheckBox Content="{Binding Toggle.Label}" IsChecked="{Binding Toggle.Checked}" Margin="0,2"
          ToolTip="{Binding Toggle.Description}" />
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource OptionTemplate}" Margin="12,0,0,2" />
       </Expander>
       <CheckBox Content="{Binding Toggle.Label}" IsChecked="{Binding Toggle.Checked}" Margin="12,6,0,6"
        Visibility="{Binding SingleVisibility}" ToolTip="{Binding Toggle.Description}" />
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <ContentPresenter Content="{Binding OtherContent, RelativeSource={RelativeSource AncestorType=local:TaskOptionsView}}" />
   </StackPanel>
   <TabControl Visibility="{Binding ForestVisibility}" SelectedIndex="{Binding ForestModeIndex, Mode=TwoWay}"
    AutomationProperties.Name="黑暗森林运行模式">
    <TabItem Header="普通">
     <StackPanel>
      <TextBlock Text="拖图寻找节点，优先挑战已开放的免费怪兽；计时探索中、探索点用尽或达到探索上限时仍检查挑战。不等待、不加速、不重置；异常最多退出重进3次。"
       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,8,6,10" />
      <ItemsControl ItemsSource="{Binding ForestBasicOptions}" ItemTemplate="{StaticResource OptionTemplate}" />
     </StackPanel>
    </TabItem>
    <TabItem Header="高级">
     <StackPanel>
      <TextBlock Text="当前高级功能不稳定：地图滑动和节点定位可能失败，请优先使用普通模式。"
       TextWrapping="Wrap" Foreground="DarkOrange" Margin="6,8,6,10" />
      <ItemsControl ItemsSource="{Binding ForestAdvancedOptions}" ItemTemplate="{StaticResource OptionTemplate}">
       <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,-5" /></Style>
       </ItemsControl.ItemContainerStyle>
      </ItemsControl>
     </StackPanel>
    </TabItem>
   </TabControl>
  </StackPanel>
 </hc:ScrollViewer>
</UserControl>
